# ============================================================
# B.A.S Sangha — Environment Variables
# Local dev:   copy to .env and fill in
# Production:  add each variable in Vercel → Settings →
#              Environment Variables (see DEPLOY.md)
# ============================================================

# ---- Database ----------------------------------------------
# Local dev (SQLite file, relative to prisma/schema.prisma):
DATABASE_URL="file:../db/custom.db"
# Production on Vercel (Turso free tier — full guide in DEPLOY.md):
# DATABASE_URL="libsql://your-db-yourorg.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ---- Auth ----------------------------------------------------
# JWT signing secret — random 64 hex chars. Generate with:  openssl rand -hex 32
AUTH_SECRET="replace-with-random-64-hex-chars"

# ---- Firebase (client web app config — public by design) ----
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Web Push certificate key (Firebase Console → Project settings →
# Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Server → Firebase. Paste the FULL service-account JSON here, base64-encoded
# as a SINGLE line. Get it: Firebase Console → Project settings → Service
# accounts → Generate new private key → then:  base64 -w0 file.json
FIREBASE_SERVICE_ACCOUNT_KEY=""
